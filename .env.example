# Copie ce fichier sous le nom .env (sans « .example ») et remplace les valeurs.
# Ne partage jamais ce fichier : il contient tes clés secrètes.

# Clé API Taostats (https://taostats.io/pro, rubrique API Keys)
TAOSTATS_API_KEY=colle_ta_cle_ici

# Bot Telegram (donné par @BotFather)
TELEGRAM_BOT_TOKEN=colle_ton_token_ici

# Ton identifiant Telegram (obtenu avec : python -m clusterwatch bot --show-chat-id)
TELEGRAM_CHAT_ID=colle_ton_chat_id_ici
